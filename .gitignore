# Julia
Manifest.toml
**/Manifest.toml

# Local dev sources (Lava checkout etc.) — never part of the package
libs/

# Freeze bundles are snapshots, not source
*.zip

# Local model snapshots (GESSO_SMOLLM2_DIR); never part of the package
snapshots/

# Editor / OS
.vscode/
.idea/
.DS_Store

# ChatGPT Work-mode campaign drops (depots, scratch, nested checkout)
work(from chatgpt)/
outputs(from chatgpt)/

# Local research scratch (repo-hygiene standard): never pushed
/research/

# Local scratch and handoff notes (repo-hygiene standard): never pushed
/.local/

# Local Performant Julia R&D tray (Matt; spaces; never pushed).
# Nested shadow must stay a symlink to the git worktree *outside* this
# checkout — git will not register a worktree inside master.
/Performant Julia toolchain/
