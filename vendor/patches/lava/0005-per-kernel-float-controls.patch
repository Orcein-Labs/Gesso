+"""
+    with_float_controls(kernel::Kernel{LavaBackend}, widths::Tuple)
+
+Require preservation of signed zero, Inf and NaN for this compute kernel's
+core SPIR-V operations at the requested widths. The contract is part of its
+callable type and hence every kernel/launch/cache identity. Unsupported devices
+reject before dispatch. GLSL extended instructions have their own contracts.
+"""
+function with_float_controls(obj::KA.Kernel{LavaBackend,W,N}, widths::Tuple) where {W,N}
+    mask = float_controls_mask(widths)
+    required_float_controls(typeof(obj.f)) == 0 ||
+        throw(ArgumentError("kernel already has a floating-point preservation contract"))
+    mask == 0 && return obj
+    f = FloatControlledKernel{typeof(obj.f),mask}(obj.f)
+    return similar(obj,f)
+end
+
 function (obj::KA.Kernel{LavaBackend})(args...; ndrange=nothing, workgroupsize=nothing)
     # `vk_context(obj.backend)`, not the global: a KA kernel carries the backend
     # it was built for, and that backend knows its device. This is the accessor
     # `test_backend_context.jl` exists to pin.
     validate_launch_args(vk_context(obj.backend), args)
+    require_float_controls(vk_context(obj.backend), required_float_controls(typeof(obj.f)))
     # A static workgroup with an interior unit extent miscompiles; take the
     # dynamic path instead. Checked on the TYPE, so it folds away for every
     # kernel that is not affected.
