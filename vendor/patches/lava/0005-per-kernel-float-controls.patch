+# The mask uses bits 0/1/2 for Float16/32/64. It describes a requested contract,
+# never a device guess; runtime capability checks happen before pipeline creation.
+function float_controls_mask(widths::Tuple)
+    mask = UInt8(0)
+    for width in widths
+        width isa Integer || throw(ArgumentError("floating-point widths must be integers"))
+        bit = float_controls_bit(width)
+        mask & bit == 0 || throw(ArgumentError("duplicate floating-point width $width"))
+        mask |= bit
+    end
+    return mask
+end
+float_controls_bit(width::Integer) = width == 16 ? UInt8(1) :
+    width == 32 ? UInt8(2) : width == 64 ? UInt8(4) :
+    throw(ArgumentError("unsupported floating-point preservation width $width"))
+function validate_float_controls_mask(mask::UInt8)
+    mask & UInt8(0xf8) == 0 || throw(ArgumentError("invalid floating-point preservation mask $mask"))
+    return mask
+end
+
+function emit_float_controls!(mod::SPIRVModule, entry::UInt32, mask::UInt8)
+    validate_float_controls_mask(mask)
+    mask == 0 && return nothing
+    require_capability!(mod, Cap.SignedZeroInfNanPreserve)
+    # SignedZeroInfNanPreserve is core in the emitted SPIR-V 1.4 version.
+    for width in (16,32,64)
+        mask & float_controls_bit(width) == 0 && continue
+        emit_execution_mode!(mod, entry, ExecMode.SignedZeroInfNanPreserve, UInt32(width))
+    end
+    return nothing
+end
+
+"""Read the union of preservation requirements in a compute module's header."""
+function spirv_float_controls_mask(bytes::Vector{UInt8})
+    length(bytes) >= 20 && length(bytes) % 4 == 0 || throw(ArgumentError("invalid SPIR-V extent"))
+    words = reinterpret(UInt32, bytes)
+    words[1] == 0x07230203 || throw(ArgumentError("invalid SPIR-V magic"))
+    mask = UInt8(0)
+    has_capability = false
+    has_extension = false
+    entries = UInt32[]
+    modes = Tuple{UInt32,UInt8}[]
+    i = 6
+    while i <= length(words)
+        n = Int(words[i] >> 16)
+        n > 0 && i+n-1 <= length(words) || throw(ArgumentError("invalid SPIR-V instruction extent"))
+        op = UInt16(words[i] & 0xffff)
+        op == Op.OpFunction && break
+        if op == Op.OpCapability && n == 2 && words[i+1] == Cap.SignedZeroInfNanPreserve
+            has_capability = true
+        elseif op == Op.OpExtension
+            data = reinterpret(UInt8, @view words[i+1:i+n-1])
+            stop = findfirst(iszero, data)
+            stop === nothing && throw(ArgumentError("unterminated SPIR-V extension string"))
+            has_extension |= String(data[1:stop-1]) == "SPV_KHR_float_controls"
+        elseif op == Op.OpEntryPoint
+            n >= 4 || throw(ArgumentError("invalid SPIR-V entry point"))
+            push!(entries, words[i+2])
+        elseif op == Op.OpExecutionMode && n >= 3 && words[i+2] == ExecMode.SignedZeroInfNanPreserve
+            n == 4 || throw(ArgumentError("invalid preservation execution mode"))
+            bit = float_controls_bit(words[i+3])
+            mode = (words[i+1], bit)
+            mode in modes && throw(ArgumentError("duplicate preservation execution mode"))
+            push!(modes, mode)
+            mask |= bit
+        end
+        i += n
+    end
+    if mask != 0
+        has_capability || throw(ArgumentError("preservation mode lacks SignedZeroInfNanPreserve capability"))
+        words[2] >= 0x00010400 || has_extension ||
+            throw(ArgumentError("preservation mode requires SPV_KHR_float_controls before SPIR-V 1.4"))
+        all(mode -> mode[1] in entries, modes) ||
+            throw(ArgumentError("preservation mode names an absent entry point"))
+    end
+    return mask
+end
