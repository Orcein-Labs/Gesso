Subject: [PATCH] fix: preserve scalar logical integer widths in SPIR-V


diff --git a/src/compiler/spirv/emit.jl b/src/compiler/spirv/emit.jl
index f1a3eca..ca12aaf 100644
--- a/src/compiler/spirv/emit.jl
+++ b/src/compiler/spirv/emit.jl
@@ -823,6 +823,20 @@ end
 # ================================================================
 
 function emit_instruction!(state::SPIRVEmitterState, inst::LLVM.Instruction)
+    # Scalar register legalization does not define memory layouts, vector
+    # lanes, atomics, bitcasts or intrinsic-specific arithmetic for odd widths.
+    # Reject those boundaries rather than silently apply native-bucket semantics.
+    odd(ty) = ty isa LLVM.IntegerType && !(LLVM.width(ty) in (1,8,16,32,64))
+    if odd(LLVM.value_type(inst)) || any(v -> odd(LLVM.value_type(v)), LLVM.operands(inst))
+        supported = inst isa Union{LLVM.AddInst,LLVM.SubInst,LLVM.MulInst,
+            LLVM.SDivInst,LLVM.UDivInst,LLVM.SRemInst,LLVM.URemInst,
+            LLVM.AndInst,LLVM.OrInst,LLVM.XorInst,LLVM.ShlInst,LLVM.LShrInst,
+            LLVM.AShrInst,LLVM.ICmpInst,LLVM.TruncInst,LLVM.ZExtInst,LLVM.SExtInst,
+            LLVM.SIToFPInst,LLVM.UIToFPInst,LLVM.FPToSIInst,LLVM.FPToUIInst,
+            LLVM.SelectInst,LLVM.FreezeInst}
+        supported || error("Unsupported logical-width integer boundary: $inst")
+    end
+
     # Track SPIR-V ID before/after to record source mapping
     id_before = state.mod.next_id
 
@@ -993,14 +1007,47 @@ end
 # Binary / Unary Operations
 # ================================================================
 
+# Odd LLVM widths are represented by native SPIR-V integer buckets. Keep the
+# low logical bits for unsigned use; signed consumers must extend the logical
+# sign bit, not the bucket sign bit. These helpers are no-ops for native widths.
+function logical_integer!(state::SPIRVEmitterState, id::UInt32, ty::LLVM.LLVMType;
+                          signed::Bool=false)
+    ty isa LLVM.IntegerType || return id
+    w = LLVM.width(ty)
+    w == 1 && return id # i1 is represented by OpTypeBool.
+    physical = Int(spirv_int_width(w))
+    w == physical && return id
+    result_ty = emit_type_int!(state.mod, UInt32(physical), UInt32(0))
+    if signed
+        amount = emit_int_constant!(state, ty, UInt64(physical - w))
+        shifted = fresh_id!(state.mod)
+        result = fresh_id!(state.mod)
+        encode_instruction!(state.mod.functions, Op.OpShiftLeftLogical,
+                            result_ty, shifted, id, amount)
+        encode_instruction!(state.mod.functions, Op.OpShiftRightArithmetic,
+                            result_ty, result, shifted, amount)
+    else
+        mask = emit_int_constant!(state, ty, (UInt64(1) << w) - UInt64(1))
+        result = fresh_id!(state.mod)
+        encode_instruction!(state.mod.functions, Op.OpBitwiseAnd,
+                            result_ty, result, id, mask)
+    end
+    return result
+end
+
 function emit_binary_op!(state::SPIRVEmitterState, inst::LLVM.Instruction, opcode::UInt16)
     ops = LLVM.operands(inst)
     lhs = get_value_id!(state, ops[1])
     rhs = get_value_id!(state, ops[2])
-    result_ty = map_type!(state.type_ctx, LLVM.value_type(inst))
+    llvm_ty = LLVM.value_type(inst)
+    signed = opcode in (Op.OpSDiv, Op.OpSRem, Op.OpShiftRightArithmetic)
+    lhs = logical_integer!(state, lhs, LLVM.value_type(ops[1]); signed)
+    rhs = logical_integer!(state, rhs, LLVM.value_type(ops[2]);
+                           signed=signed && opcode != Op.OpShiftRightArithmetic)
+    result_ty = map_type!(state.type_ctx, llvm_ty)
     result_id = fresh_id!(state.mod)
     encode_instruction!(state.mod.functions, opcode, result_ty, result_id, lhs, rhs)
-    state.value_map[inst] = result_id
+    state.value_map[inst] = logical_integer!(state, result_id, llvm_ty)
 end
 
 function emit_unary_op!(state::SPIRVEmitterState, inst::LLVM.Instruction, opcode::UInt16)
@@ -1075,6 +1122,11 @@ function emit_icmp!(state::SPIRVEmitterState, inst::LLVM.ICmpInst)
     lhs = get_value_id!(state, lhs_val)
     rhs = get_value_id!(state, rhs_val)
 
+    signed = pred in (LLVM.API.LLVMIntSGT, LLVM.API.LLVMIntSGE,
+                      LLVM.API.LLVMIntSLT, LLVM.API.LLVMIntSLE)
+    lhs = logical_integer!(state, lhs, LLVM.value_type(lhs_val); signed)
+    rhs = logical_integer!(state, rhs, LLVM.value_type(rhs_val); signed)
+
     # SPIR-V requires both operands to have the same type.
     # LLVM constants may be i32 when the other operand is i8/i64/etc.
     # Insert OpUConvert or OpSConvert if widths don't match.
@@ -5491,9 +5543,18 @@ function emit_conversion!(state::SPIRVEmitterState, inst::LLVM.Instruction, opco
             src = bitcast_id
         end
     end
-    result_id = fresh_id!(state.mod)
-    encode_instruction!(state.mod.functions, opcode, result_ty, result_id, src)
-    state.value_map[inst] = result_id
+    src_ty = LLVM.value_type(ops[1])
+    src = logical_integer!(state, src, src_ty;
+                           signed=opcode in (Op.OpSConvert, Op.OpConvertSToF))
+    if opcode in (Op.OpUConvert, Op.OpSConvert) &&
+       src_ty isa LLVM.IntegerType && llvm_ty isa LLVM.IntegerType &&
+       spirv_int_width(LLVM.width(src_ty)) == spirv_int_width(LLVM.width(llvm_ty))
+        state.value_map[inst] = logical_integer!(state, src, llvm_ty)
+    else
+        result_id = fresh_id!(state.mod)
+        encode_instruction!(state.mod.functions, opcode, result_ty, result_id, src)
+        state.value_map[inst] = logical_integer!(state, result_id, llvm_ty)
+    end
 end
 
 function emit_int_to_fp!(state::SPIRVEmitterState, inst::LLVM.Instruction, opcode::UInt16)
@@ -5505,7 +5566,8 @@ function emit_int_to_fp!(state::SPIRVEmitterState, inst::LLVM.Instruction, opcod
         # i1 → select(bool, 1, 0) → OpConvertUToF/OpConvertSToF
         src_id = get_value_id!(state, src_val)
         i32_ty = map_type!(state.type_ctx, LLVM.IntType(32))
-        one_id = emit_constant_u32!(state.mod, UInt32(1))
+        true_bits = opcode == Op.OpConvertSToF ? typemax(UInt32) : UInt32(1)
+        one_id = emit_constant_u32!(state.mod, true_bits)
         zero_id = emit_constant_u32!(state.mod, UInt32(0))
         int_id = fresh_id!(state.mod)
         encode_instruction!(state.mod.functions, Op.OpSelect, i32_ty, int_id, src_id, one_id, zero_id)
@@ -5527,8 +5589,13 @@ function emit_trunc!(state::SPIRVEmitterState, inst::LLVM.TruncInst)
     src_ty = LLVM.value_type(LLVM.operands(inst)[1])
     dst_ty = LLVM.value_type(inst)
     if dst_ty isa LLVM.IntegerType && LLVM.width(dst_ty) == 1
-        # trunc to i1: compare != 0
+        # LLVM trunc keeps the low bit; nonzero even inputs become false.
         src_id = get_value_id!(state, LLVM.operands(inst)[1])
+        lowbit = fresh_id!(state.mod)
+        int_ty = emit_type_int!(state.mod, spirv_int_width(LLVM.width(src_ty)), UInt32(0))
+        one_id = emit_int_constant!(state, src_ty, UInt64(1))
+        encode_instruction!(state.mod.functions, Op.OpBitwiseAnd, int_ty, lowbit, src_id, one_id)
+        src_id = lowbit
         zero_id = get_zero_constant!(state, src_ty)
         result_ty = map_type!(state.type_ctx, dst_ty)
         result_id = fresh_id!(state.mod)
@@ -5558,9 +5625,12 @@ function emit_trunc!(state::SPIRVEmitterState, inst::LLVM.TruncInst)
             state.value_map[bcast_inst] = bcast_id
         else
             result_ty = emit_type_int!(state.mod, spirv_int_width(LLVM.width(dst_ty)), UInt32(0))
-            result_id = fresh_id!(state.mod)
-            encode_instruction!(state.mod.functions, Op.OpUConvert, result_ty, result_id, src_id)
-            state.value_map[inst] = result_id
+            result_id = src_id
+            if spirv_int_width(LLVM.width(src_ty)) != spirv_int_width(LLVM.width(dst_ty))
+                result_id = fresh_id!(state.mod)
+                encode_instruction!(state.mod.functions, Op.OpUConvert, result_ty, result_id, src_id)
+            end
+            state.value_map[inst] = logical_integer!(state, result_id, dst_ty)
         end
     else
         # trunc with non-IntegerType dst — shouldn't happen in valid LLVM but handle gracefully.
diff --git a/src/compiler/spirv/types.jl b/src/compiler/spirv/types.jl
index a000ebe..14d3df3 100644
--- a/src/compiler/spirv/types.jl
+++ b/src/compiler/spirv/types.jl
@@ -913,6 +913,7 @@ LLVM allows arbitrary widths (i2, i3, i7, ...) but SPIR-V only supports 8, 16, 3
 Width 1 (i1) is NOT handled here -- callers must map it to OpTypeBool separately.
 """
 function spirv_int_width(w::Integer)::UInt32
+    1 <= w <= 64 || error("Unsupported LLVM integer width $w; SPIR-V buckets support at most 64 bits")
     w <= 8  && return UInt32(8)
     w <= 16 && return UInt32(16)
     w <= 32 && return UInt32(32)
@@ -972,6 +973,10 @@ function emit_llvm_type!(ctx::SPIRVTypeContext, ty::LLVM.StructType)
 end
 
 function emit_llvm_type!(ctx::SPIRVTypeContext, ty::LLVM.VectorType)
+    elem = eltype(ty)
+    if elem isa LLVM.IntegerType && !(LLVM.width(elem) in (1,8,16,32,64))
+        error("Unsupported vector of logical-width integers: $ty")
+    end
     # <N x T> → OpTypeVector
     elem_spirv = map_type!(ctx, eltype(ty))
     n = length(ty)
@@ -1610,9 +1615,10 @@ function map_constant_int!(ctx::SPIRVTypeContext, val::LLVM.ConstantInt, ty::LLV
             encode_instruction!(ctx.mod.types_constants, Op.OpConstant, type_id, id, bits)
             id
         end
-    elseif w == 64
-        # 64-bit constant: two UInt32 words (little-endian)
-        bits = reinterpret(UInt64, Int64(int_val))
+    elseif w <= 64
+        # Native 64-bit bucket, with zeroed padding for logical i33..i63.
+        mask = w == 64 ? typemax(UInt64) : (UInt64(1) << w) - UInt64(1)
+        bits = reinterpret(UInt64, Int64(int_val)) & mask
         lo = UInt32(bits & 0xFFFFFFFF)
         hi = UInt32((bits >> 32) & 0xFFFFFFFF)
         key = (:const, type_id, bits)
