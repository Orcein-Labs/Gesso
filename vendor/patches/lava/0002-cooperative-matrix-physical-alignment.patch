diff --git a/src/compiler/spirv/coopmat.jl b/src/compiler/spirv/coopmat.jl
index 4ddb7d4..d4c3be9 100644
--- a/src/compiler/spirv/coopmat.jl
+++ b/src/compiler/spirv/coopmat.jl
@@ -284,8 +284,13 @@ function emit_coopmat_call!(state::SPIRVEmitterState, inst::LLVM.CallInst,
                                 mat_ty, id, ptr_id, layout_id, stride_id,
                                 MemOp.NonPrivatePointer)
         else
+            # PhysicalStorageBuffer64 requires Aligned on every physical
+            # memory access (Vulkan VUID 04708/06314), including cooperative
+            # matrices. The pointer addresses a scalar component; promise only
+            # its alignment, independently of the tile's runtime requirements.
             encode_instruction!(mod.functions, Op.OpCooperativeMatrixLoadKHR,
-                                mat_ty, id, ptr_id, layout_id, stride_id)
+                                mat_ty, id, ptr_id, layout_id, stride_id,
+                                MemOp.Aligned, UInt32(parse(Int, dtype[2:end]) ÷ 8))
         end
         state.value_map[inst] = id
         state.coopmat_value_types[inst] = mat_ty
@@ -304,7 +309,8 @@ function emit_coopmat_call!(state::SPIRVEmitterState, inst::LLVM.CallInst,
                                 MemOp.NonPrivatePointer)
         else
             encode_instruction!(mod.functions, Op.OpCooperativeMatrixStoreKHR,
-                                ptr_id, obj_id, layout_id, stride_id)
+                                ptr_id, obj_id, layout_id, stride_id,
+                                MemOp.Aligned, UInt32(parse(Int, dtype[2:end]) ÷ 8))
         end
 
     elseif op == "zero"
