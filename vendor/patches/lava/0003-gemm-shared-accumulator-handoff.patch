+module LavaGemmAccumulatorStoreContractTest
+
+# Tier 3 device regression for Lava's direct register-blocked coopmat GEMM.
+# Every call below forces `staged=false` and passes (BLK, SPLITK) explicitly;
+# there is no mul! dispatch or scalar fallback in the path under test.
+
+using Test, Lava, LinearAlgebra, Random
+const KA = Lava.KernelAbstractions
+
+const C1_CTX = Lava.vk_context()
+Lava.coopmat_gemm_available(C1_CTX) ||
+    error("this suite requires the device's direct 16x16x16 F16 cooperative-matrix path")
+const C1_F16 = Lava._vk_component_type(Float16)
+const C1_F32 = Lava._vk_component_type(Float32)
+any(
+    s ->
+        s.M == 16 &&
+        s.N == 16 &&
+        s.K == 16 &&
+        s.ab_type == C1_F16 &&
+        s.c_type == C1_F32 &&
+        s.scope == Lava.VK_SCOPE_SUBGROUP,
+    C1_CTX.coopmat_shapes,
+) || error("device does not report the required 16x16x16 F16-to-F32 accumulator shape")
+println(
+    "C1_COOPMAT_DEVICE name=$(C1_CTX.device_name) " *
+    "subgroup=$(Lava.device_subgroup_size(C1_CTX)) threads=$(Threads.nthreads())",
+)
+
+# Dyadic inputs make every F16 product and every F32 partial sum exactly
+# representable: A,B are multiples of 1/8, K <= 512, and |sum| <= 2048.
+# The first two rows and first column force both signs for the ReLU cases.
+function c1_dyadic_inputs(M::Int, K::Int, N::Int, seed::Int)
+    rng = MersenneTwister(seed)
+    A = Float16.(rand(rng, -16:16, M, K) ./ 8)
+    B = Float16.(rand(rng, -16:16, K, N) ./ 8)
+    A[1, :] .= Float16(0.5)
+    A[2, :] .= Float16(-0.5)
+    B[:, 1] .= Float16(0.5)
+    return A, B
+end
+
+function c1_continuous_inputs(M::Int, K::Int, N::Int, seed::Int)
+    rng = MersenneTwister(seed)
+    A = Float16.(0.25f0 .* randn(rng, Float32, M, K))
+    B = Float16.(0.25f0 .* randn(rng, Float32, K, N))
+    return A, B
+end
+
+c1_relu(x::T) where {T<:AbstractFloat} = max(x, zero(T))
+
+function c1_host_dot(
+    A::AbstractMatrix,
+    B::AbstractMatrix,
+    krange::UnitRange{Int} = 1:size(A, 2),
+)
+    Float64.(view(A, :, krange)) * Float64.(view(B, krange, :))
+end
+
+function c1_host_output(
+    A,
+    B,
+    ::Type{T};
+    bias = nothing,
+    epilogue = identity,
+    krange::UnitRange{Int} = 1:size(A, 2),
+) where {T<:AbstractFloat}
+    dot = c1_host_dot(A, B, krange)
+    out = Matrix{T}(undef, size(dot))
+    @inbounds for i in eachindex(dot)
+        v = dot[i] + (bias === nothing ? 0.0 : Float64(bias[mod1(i, size(dot, 1))]))
+        rounded = T(v) # Lava converts the F32 accumulator to C before the epilogue.
+        out[i] = epilogue(rounded)
+    end
+    return out
+end
+
+function c1_dispatch(
+    Ah::Matrix{Float16},
+    Bh::Matrix{Float16},
+    ::Type{TC};
+    blk::Int,
+    split::Int,
+    reduce::Bool = true,
+    bias_host = nothing,
+    epilogue = identity,
+) where {TC<:AbstractFloat}
+    M, K = size(Ah)
+    size(Bh, 1) == K || error("host test operands do not conform")
+    N = size(Bh, 2)
+    A = Lava.LavaArray(Ah)
+    B = Lava.LavaArray(Bh)
+    C = Lava.LavaArray{TC}(undef, M, N)
+    fill!(C, TC(NaN))
+    bias = bias_host === nothing ? nothing : Lava.LavaArray(bias_host)
+    partials = split == 1 ? nothing : Lava.LavaArray{Float32}(undef, M, N, split)
+    partials === nothing || fill!(partials, Float32(NaN))
+
+    Lava.coopmat_gemm!(
+        C,
+        A,
+        B,
+        M,
+        N,
+        K;
+        blk_split = (blk, split),
+        partials,
+        reduce,
+        bias,
+        epilogue,
+        staged = false,
+    )
+    KA.synchronize(KA.get_backend(C))
+    got_C = Array(C)
+    got_partials = partials === nothing ? nothing : Array(partials)
+    return got_C, got_partials
+end
+
+function c1_assert_exact(got, want)
+    @test size(got) == size(want)
+    @test all(isfinite, got)
+    @test got == want
+end
+
+function c1_assert_partial_planes(got, A, B, split::Int, kper::Int)
+    @test size(got) == (size(A, 1), size(B, 2), split)
+    @test all(isfinite, got)
+    for s = 1:split
+        lo = (s - 1) * kper * 16 + 1
+        hi = s * kper * 16
+        want = Float32.(c1_host_dot(A, B, lo:hi))
+        @test got[:, :, s] == want
+    end
+end
+
+function c1_assert_close(got, want; tolerance::Float64 = 1e-4)
+    @test size(got) == size(want)
+    @test all(isfinite, got)
+    scale = max(1.0, maximum(abs, want))
+    err = maximum(abs.(Float64.(got) .- want)) / scale
+    @test err <= tolerance
+end
+
+function c1_strided_gemm_spirv(ctx)
+    for linked in values(ctx.caches.linked)
+        occursin("strided_gemm_kernel", Lava.kernel_source_name(linked.compiled)) ||
+            continue
+        return linked.compiled.spirv_bytes
+    end
+    for (key, linked) in ctx.caches.frozen_mem
+        linked isa Lava.LavaLinkedKernel || continue
+        occursin("strided_gemm_kernel", Lava.frozen_key_source_name(key)) || continue
+        return linked.compiled.spirv_bytes
+    end
+    return nothing
+end
+
+@testset "direct cooperative-matrix GEMM store contract" begin
+    # 3 BLKs × 2 split counts × 2 KPER parity values × 2 output-tile counts.
+    # The one-tile/split-one configurations have an odd subgroup total; all
+    # two-tile and split-eight configurations have an even total.
+    # Keep those odd subgroup totals as a dispatch-boundary case too.
+    @testset "basic output and reduce=false partial-plane coverage" begin
+        case = 0
+        odd_subgroup_cases = 0
+        even_subgroup_cases = 0
+        for blk in (1, 2, 4), split in (1, 8), kper in (3, 4), tiles in (1, 2)
+            case += 1
+            M, N, K = 16 * blk, 16 * blk * tiles, 16 * split * kper
+            nsubgroups = tiles * split
+            isodd(nsubgroups) ? (odd_subgroup_cases += 1) : (even_subgroup_cases += 1)
+            dtype_flip = iseven(kper + tiles)
+            TC =
+                split == 1 ? (dtype_flip ? Float32 : Float16) :
+                (dtype_flip ? Float16 : Float32)
+            Ah, Bh = c1_dyadic_inputs(M, K, N, 80_000 + case)
+            label =
+                "BLK=$blk split=$split KPER=$kper output_tiles=$tiles " *
+                "subgroups=$nsubgroups C=$(nameof(TC))"
+            @testset "$label" begin
+                got_C, got_partials =
+                    c1_dispatch(Ah, Bh, TC; blk, split, reduce = (split == 1))
+                if split == 1
+                    c1_assert_exact(got_C, c1_host_output(Ah, Bh, TC))
+                else
+                    c1_assert_partial_planes(got_partials, Ah, Bh, split, kper)
+                    # reduce=false must leave the caller's poisoned C untouched.
+                    @test all(isnan, got_C)
+                end
+            end
+        end
+        @test case == 24
+        @test odd_subgroup_cases == 6
+        @test even_subgroup_cases == 18
+    end
+
+    # Exercise every output/bias element-type pair with both identity and a
+    # type-preserving activation, across all three register blocks.
+    @testset "split-one bias and post-conversion epilogue" begin
+        case = 0
+        for blk in (1, 2, 4),
+            BiasT in (Float16, Float32),
+            CT in (Float16, Float32),
+            epi in (identity, c1_relu)
+
+            case += 1
+            tiles = isodd(case + blk) ? 1 : 2
+            kper = isodd(case) ? 3 : 4
+            M, N, K = 16 * blk, 16 * blk * tiles, 16 * kper
+            Ah, Bh = c1_dyadic_inputs(M, K, N, 90_000 + case)
+            bias_host = BiasT.(rand(MersenneTwister(100_000 + case), -16:16, M) ./ 16)
+            epi_name = epi === identity ? "identity" : "relu"
+            label =
+                "BLK=$blk C=$(nameof(CT)) bias=$(nameof(BiasT)) epi=$epi_name " *
+                "output_tiles=$tiles KPER=$kper"
+            @testset "$label" begin
+                got_C, _ =
+                    c1_dispatch(Ah, Bh, CT; blk, split = 1, bias_host, epilogue = epi)
+                want = c1_host_output(Ah, Bh, CT; bias = bias_host, epilogue = epi)
+                c1_assert_exact(got_C, want)
+                if epi === c1_relu
+                    @test any(iszero, want)
+                    @test any(x -> x > zero(CT), want)
+                end
+            end
+        end
+        @test case == 24
+    end
+
+    # With reduce=true, poison both C and the caller-owned partial buffer, then
+    # check every partial plane as well as the final reduction result.
+    @testset "split-K reduction covers every explicit partial plane" begin
+        case = 0
+        for blk in (1, 2, 4), (kper, tiles, TC) in ((3, 1, Float32), (4, 2, Float16))
+            case += 1
+            split = 8
+            M, N, K = 16 * blk, 16 * blk * tiles, 16 * split * kper
+            Ah, Bh = c1_dyadic_inputs(M, K, N, 110_000 + case)
+            label = "BLK=$blk split=8 KPER=$kper output_tiles=$tiles C=$(nameof(TC))"
+            @testset "$label" begin
+                got_C, got_partials = c1_dispatch(Ah, Bh, TC; blk, split, reduce = true)
+                c1_assert_exact(got_C, c1_host_output(Ah, Bh, TC))
+                c1_assert_partial_planes(got_partials, Ah, Bh, split, kper)
+            end
+        end
+        @test case == 6
+    end
+
+    # Continuous F16 inputs use a tolerance against a Float64 host reference;
+    # they avoid imposing bitwise equality where F32 accumulation order matters.
+    @testset "continuous-input F32 accuracy" begin
+        case = 0
+        for blk in (1, 2, 4), (split, kper, tiles) in ((1, 3, 1), (8, 4, 2))
+            case += 1
+            M, N, K = 16 * blk, 16 * blk * tiles, 16 * split * kper
+            Ah, Bh = c1_continuous_inputs(M, K, N, 120_000 + case)
+            label = "BLK=$blk split=$split KPER=$kper output_tiles=$tiles"
+            @testset "$label" begin
+                got_C, got_partials =
+                    c1_dispatch(Ah, Bh, Float32; blk, split, reduce = true)
+                c1_assert_close(got_C, c1_host_dot(Ah, Bh))
+                if split > 1
+                    @test all(isfinite, got_partials)
+                    for s = 1:split
+                        lo = (s - 1) * kper * 16 + 1
+                        hi = s * kper * 16
+                        c1_assert_close(got_partials[:, :, s], c1_host_dot(Ah, Bh, lo:hi))
+                    end
+                end
+            end
+        end
+        @test case == 6
+    end
+
+    @testset "explicit-layout feature gates GEMM dispatch" begin
+        ctx = C1_CTX
+        M = N = 256
+        K = 32
+        rng = MersenneTwister(130_001)
+        Ah = Float16.(rand(rng, -8:8, M, K) ./ 8)
+        Bh = Float16.(rand(rng, -8:8, K, N) ./ 8)
+        A = Lava.LavaArray(Ah)
+        B = Lava.LavaArray(Bh)
+        C = Lava.LavaArray{Float32}(undef, M, N)
+        backend = KA.get_backend(C)
+        KA.synchronize(backend)
+
+        @test ctx.wg_explicit_layout_enabled
+        @test ctx.coopmat_available
+        @test Lava.coopmat_gemm_available(ctx)
+        @test Lava.staged_gemm_ok(C, A, B, M, N)
+
+        old_wg_explicit = ctx.wg_explicit_layout_enabled
+        old_caps = ctx.caches.caps
+        old_dispatch_logging = ctx.diag.dispatch_logging
+        old_dispatch_log_file = ctx.diag.dispatch_log_file
+        old_dispatch_log = Lava.get_dispatch_log(ctx)
+        old_coopmat_available = ctx.coopmat_available
+        try
+            ctx.wg_explicit_layout_enabled = false
+            ctx.caches.caps = nothing
+            ctx.diag.dispatch_log_file = nothing
+            empty!(ctx.diag.dispatch_log)
+            Lava.set_dispatch_logging!(true, ctx)
